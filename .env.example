# market-agri-worker — every variable this repository reads.
# Copy to .env (ignored by git) for a local run. Placeholders only: never commit real values.

# Read by application.yml: HTTP port inside the container and the database, always as worker_app
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/market_agri
DATABASE_USER=worker_app
DATABASE_PASSWORD=<worker_app password>

# Read by deploy/compose.yml (from the market-agri-infra env file)
ENV=<dev|qa|main>
PG_DATABASE=market_agri
WORKER_APP_PASSWORD=<worker_app password>
# PG_ADMIN_USER and PG_ADMIN_PASSWORD: only for worker-db-migrate (deploy/compose.yml)
